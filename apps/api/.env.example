# apps/api environment. Copy to apps/api/.env (gitignored); `pnpm dev` / `start` load it.
# Everything is optional outside production: with nothing set, the API runs on embedded
# Postgres (PGlite in .data/pglite), an in-memory KV and a generated dev signing key.

# development | test | production (production makes DATABASE_URL, REDIS_URL,
# ACCESS_TOKEN_PRIVATE_KEY, JOIN_TICKET_PRIVATE_KEY and CORS_ORIGINS required)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787

# docker compose up -d (repo root) → Postgres 18 on 55432, Valkey 8 on 56379
# DATABASE_URL=postgres://game:game@localhost:55432/game
# REDIS_URL=redis://localhost:56379
# PGlite directory when DATABASE_URL is unset (relative to apps/api); memory:// = throwaway
PGLITE_DIR=.data/pglite

# Ed25519 PKCS#8 PEM that signs access tokens; `\n` escapes are fine.
# Generate: pnpm --filter @military-forge/api keygen
# ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Comma-separated exact origins. Unset outside production = any http://localhost:* / 127.0.0.1:*
# CORS_ORIGINS=https://play.example.com

# Refresh-token cookie. Secure defaults to true in production. SameSite=None (portal iframes) needs Secure.
# COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=example.com

# Where the client IP for rate limits comes from: none (socket) | cloudflare (CF-Connecting-IP) |
# xff (X-Forwarded-For, appended to by TRUST_PROXY_HOPS trusted proxies; the client IP is the entry
# that many places from the right, since anything left of it is whatever the client sent).
# Rate limits key IPv4 per address and IPv6 per /64.
TRUST_PROXY=none
TRUST_PROXY_HOPS=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Extra impersonation-protected names (staff), comma-separated
# RESERVED_NICKNAMES=

# Public WebSocket base of the game server: POST /rooms answers gsUrl = <it>/ws/<code>.
# Unset = null, and clients use their own origin's /ws/<code> (one origin behind a proxy, as in pnpm playtest).
# GAME_SERVER_URL=wss://play.example.com

# Join tickets (docs/06 §6): an Ed25519 key of their own (not the access-token key) that signs a
# one-use ticket per room create/join; give its public half to the game server as
# JOIN_TICKET_PUBLIC_KEY. Unset outside production = no tickets (a dev game server's rooms are open).
# JOIN_TICKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JOIN_TICKET_TTL_SECONDS=30

# Room codes to hold open from start-up, comma-separated: a restarted API (in-memory KV) keeps the
# links it handed out. pnpm playtest sets it when it restarts the API.
# KEEP_ROOMS=KQXMZP,BGAKSS

# GET /version: oldest web client build that may still play (older ones must reload), and the newest.
# Unset = null (no constraint).
# MIN_CLIENT_VERSION=0.1.0
# LATEST_CLIENT_VERSION=0.1.0

# Match results from the game server (POST /internal/matches, docs/07 §12): the public half of the
# game server's own Ed25519 results key (the game server holds RESULTS_PRIVATE_KEY and API_URL).
# Unset = the route is off and no results are recorded.
# RESULTS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Saved accounts' emails (auth/email.ts): "Forgot password?" and confirming a saved account's email.
# Unset = off: the web hides "Forgot password?" and "Save your account" links the email at once.
# resend: Resend's HTTP API (or any with the same request: EMAIL_API_URL), needs EMAIL_API_KEY and EMAIL_FROM.
# log: development only, writes each email (link included) to the API's log instead of sending it.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_...
# EMAIL_FROM="Military Forge <no-reply@example.com>"
# EMAIL_API_URL=https://api.resend.com/emails
# Where the emailed links open (the game's public address). Default: the first CORS_ORIGINS entry,
# else http://localhost:5173 (Vite's dev server).
# APP_URL=https://play.example.com
# Play stats (docs/16-player-metrics.md). All optional: the defaults are the privacy-first ones.
# Raw events are kept this many days (7-400); the anonymous daily counts are kept for good.
# ANALYTICS_RAW_DAYS=90
# "Help improve the game" outside Europe: opt-in (default) or opt-out. Europe (EU/EEA, UK, CH) is always opt-in.
# ANALYTICS_CONSENT=opt-in
# House-ad rotation may weight on a consenting player's segments (device, play time, mode...). Off by default.
# ANALYTICS_AD_SEGMENTS=false
# An IP-range -> country CSV (start,end,CC lines, e.g. DB-IP "IP to Country Lite", CC BY 4.0). The
# address is looked up and dropped. Unset = the country comes from the device's time zone.
# ANALYTICS_GEOIP_CSV=/var/lib/military-forge/geoip-country.csv
