# apps/api environment. Copy to apps/api/.env (gitignored); `pnpm dev` / `start` load it.
# Everything is optional outside production: with nothing set, the API runs on embedded
# Postgres (PGlite in .data/pglite), an in-memory KV and a generated dev signing key.

# development | test | production (production makes DATABASE_URL, REDIS_URL,
# ACCESS_TOKEN_PRIVATE_KEY and CORS_ORIGINS required)
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787

# docker compose up -d (repo root) → Postgres 18 on 55432, Valkey 8 on 56379
# DATABASE_URL=postgres://game:game@localhost:55432/game
# REDIS_URL=redis://localhost:56379
# PGlite directory when DATABASE_URL is unset (relative to apps/api); memory:// = throwaway
PGLITE_DIR=.data/pglite

# Ed25519 PKCS#8 PEM that signs access tokens; `\n` escapes are fine.
# Generate: pnpm --filter @military-forge/api keygen
# ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Comma-separated exact origins. Unset outside production = any http://localhost:* / 127.0.0.1:*
# CORS_ORIGINS=https://play.example.com

# Refresh-token cookie. Secure defaults to true in production. SameSite=None (portal iframes) needs Secure.
# COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN=example.com

# Where the client IP for rate limits comes from: none (socket) | cloudflare (CF-Connecting-IP) |
# xff (X-Forwarded-For, appended to by TRUST_PROXY_HOPS trusted proxies; the client IP is the entry
# that many places from the right, since anything left of it is whatever the client sent).
# Rate limits key IPv4 per address and IPv6 per /64.
TRUST_PROXY=none
TRUST_PROXY_HOPS=1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Extra impersonation-protected names (staff), comma-separated
# RESERVED_NICKNAMES=

# GET /version: oldest web client build that may still play (older ones must reload), and the newest.
# Unset = null (no constraint).
# MIN_CLIENT_VERSION=0.1.0
# LATEST_CLIENT_VERSION=0.1.0
