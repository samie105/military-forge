{
  "name": "@military-forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "keygen": "tsx scripts/keygen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@hono/node-server": "2.1.5",
    "@military-forge/content": "workspace:*",
    "@military-forge/protocol": "workspace:*",
    "@military-forge/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0"
  }
}
