{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiled map (MapDef)",
  "description": "packages/content maps/types.ts. Generated by mapJsonSchema(): do not edit by hand.",
  "type": "object",
  "required": [
    "id",
    "name",
    "bounds",
    "solids",
    "oneWays",
    "spawns",
    "dummies",
    "labels"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "description": "Unique map id, e.g. \"storm-front\"."
    },
    "name": {
      "type": "string"
    },
    "bounds": {
      "type": "object",
      "required": [
        "minX",
        "minY",
        "maxX",
        "maxY"
      ],
      "properties": {
        "minX": {
          "type": "number"
        },
        "minY": {
          "type": "number"
        },
        "maxX": {
          "type": "number"
        },
        "maxY": {
          "type": "number"
        }
      },
      "description": "Falling below minY + 0.5 kills."
    },
    "solids": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "description": "Flat [x0, y0, x1, y1, …], either winding, not self-intersecting."
          },
          "material": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "0 concrete, 1 metal, 2 wood, 3 dirt, 4 glass."
          }
        }
      }
    },
    "oneWays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ax",
          "ay",
          "bx",
          "by"
        ],
        "additionalProperties": false,
        "properties": {
          "ax": {
            "type": "number"
          },
          "ay": {
            "type": "number"
          },
          "bx": {
            "type": "number"
          },
          "by": {
            "type": "number"
          },
          "blocksBullets": {
            "type": "boolean",
            "description": "A floor or roof slab rather than a railing: still one-way for bodies, but it stops bullets, ricochets, grenades, blasts, gas and sight like a wall. Default false."
          }
        }
      },
      "description": "Platforms you fly up through and land on; hold Down to drop. Bullets pass them unless blocksBullets."
    },
    "bulletOnly": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "description": "Flat [x0, y0, x1, y1, …], either winding."
          },
          "material": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "0 concrete, 1 metal, 2 wood, 3 dirt, 4 glass (default metal)."
          }
        }
      },
      "description": "Thin parts (poles, posts, rails, plates) that stop bullets and the bots' line of fire but not bodies, grenades, blasts, gas or sight. A bullet starting inside one leaves it."
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "description": "Feet positions for players."
    },
    "dummies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "x",
          "y",
          "script"
        ]
      },
      "description": "Scripted targets for local play."
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "text"
        ]
      }
    },
    "rules": {
      "$ref": "#/$defs/modifiers",
      "description": "Map-wide modifiers (docs/02 §20)."
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      },
      "description": "Areas that change the rules inside them (docs/02 §20.2)."
    },
    "events": {
      "$ref": "#/$defs/events"
    },
    "spawners": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spawner"
      },
      "description": "Pickup spawners: items at random spots and times (docs/03 §12)."
    },
    "armory": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "dir": {
          "enum": [
            1,
            -1
          ]
        }
      },
      "description": "Where the test armory's rack starts (one of every gun, GameOptions.armory): the first gun's x, a height above its floor, and the way the rack runs."
    }
  },
  "$defs": {
    "spawner": {
      "type": "object",
      "required": [
        "id",
        "pool",
        "spots",
        "first",
        "respawn"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "For debug views and logs."
        },
        "pool": {
          "enum": [
            "shield",
            "weapons",
            "weapon:hammer44",
            "weapon:buzz",
            "weapon:k47",
            "weapon:breacher",
            "weapon:widow",
            "weapon:machete",
            "weapon:hawk50",
            "weapon:rattler",
            "weapon:hornet",
            "weapon:trident",
            "weapon:bullpup",
            "weapon:longbow",
            "weapon:shredder",
            "weapon:arc",
            "weapon:thumper",
            "weapon:popper",
            "weapon:ripper",
            "weapon:pulse",
            "weapon:dragon",
            "grenades"
          ],
          "description": "What can appear (SPAWN_POOLS in packages/content pickups.ts)."
        },
        "spots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          },
          "minItems": 1,
          "description": "Where an item can appear: the point it rests on, on the floor."
        },
        "first": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Seconds before the first item, uniformly random in [min, max]."
        },
        "respawn": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Seconds from an item being taken until the next one appears, uniformly random in [min, max]."
        },
        "maxActive": {
          "type": "integer",
          "minimum": 1,
          "description": "Items from this spawner on the map at once (default 1, at most its spots' count)."
        }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravityMul": {
          "type": "number",
          "minimum": -2,
          "maximum": 3,
          "description": "Gravity (×). docs/02 §20.1."
        },
        "fuelBurnMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Fuel burn (×). docs/02 §20.1."
        },
        "fuelRegenMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Fuel refill (×). docs/02 §20.1."
        },
        "bulletRangeMul": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 4,
          "description": "Bullet range (×). docs/02 §20.1."
        },
        "moveSpeedMul": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3,
          "description": "Move speed (×). docs/02 §20.1."
        },
        "knockbackMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Knockback (×). docs/02 §20.1."
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Drag (1/s). docs/02 §20.1."
        },
        "wind": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -40,
            "maximum": 40
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Wind (m/s²). docs/02 §20.1. [x, y]"
        },
        "dive": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Dive (m/s²). docs/02 §20.1."
        },
        "jetDisabled": {
          "type": "boolean",
          "description": "Jetpacks off. docs/02 §20.1."
        }
      }
    },
    "zone": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "rect"
          ]
        },
        {
          "required": [
            "points"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the map."
        },
        "kind": {
          "oneOf": [
            {
              "const": "zeroG",
              "description": "Zero-g: No gravity: you drift on what speed you have. Hold Down to dive. Defaults: gravityMul 0, drag 0.4, dive 14."
            },
            {
              "const": "lowG",
              "description": "Low gravity: Gravity at a third: long jumps and slow falls. Defaults: gravityMul 0.35."
            },
            {
              "const": "reverseG",
              "description": "Reversed gravity: Gravity pulls up. Hold Down to fight it; you bob at the top edge. Defaults: gravityMul -0.6, dive 30, drag 1.5."
            },
            {
              "const": "longFlight",
              "description": "Long flight: Jet fuel burns at 40%: flights last 2.5× longer. Defaults: fuelBurnMul 0.4."
            },
            {
              "const": "damping",
              "description": "Bullet fog: Bullets crossing it use up their range 3× faster. Defaults: bulletRangeMul 0.35."
            },
            {
              "const": "wind",
              "description": "Wind: A steady push on fliers and grenades. Defaults: wind [12, 0]."
            },
            {
              "const": "slow",
              "description": "Mud: Slow going: speed caps at 45%, heavy drag. Defaults: moveSpeedMul 0.45, drag 3."
            },
            {
              "const": "water",
              "description": "Deep water: Slow, floaty and draggy; bullets die in it. Defaults: moveSpeedMul 0.6, gravityMul 0.45, drag 1.5, bulletRangeMul 0.4."
            },
            {
              "const": "jumpPad",
              "description": "Jump pad: Launches you straight up. Defaults: launch [0, 16]."
            },
            {
              "const": "boostPad",
              "description": "Boost pad: Throws you forward in a long, low arc. Defaults: launch [16, 9]."
            },
            {
              "const": "emp",
              "description": "EMP field: Jetpacks cut out inside. Defaults: jetDisabled true."
            },
            {
              "const": "custom",
              "description": "Custom: Only the effects you set. No defaults: only what you set."
            }
          ],
          "description": "Fills in every effect the zone leaves out."
        },
        "rect": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[minX, minY, maxX, maxY]"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "description": "Flat [x0, y0, x1, y1, …], either winding."
        },
        "launch": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Pads, m/s [x, y]: your speed along it rises to at least its length (each component within ±26)."
        },
        "event": {
          "type": "string",
          "description": "Only on while this event runs (an event zone)."
        },
        "label": {
          "type": "string"
        },
        "gravityMul": {
          "type": "number",
          "minimum": -2,
          "maximum": 3,
          "description": "Gravity (×). docs/02 §20.1."
        },
        "fuelBurnMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Fuel burn (×). docs/02 §20.1."
        },
        "fuelRegenMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Fuel refill (×). docs/02 §20.1."
        },
        "bulletRangeMul": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 4,
          "description": "Bullet range (×). docs/02 §20.1."
        },
        "moveSpeedMul": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3,
          "description": "Move speed (×). docs/02 §20.1."
        },
        "knockbackMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Knockback (×). docs/02 §20.1."
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Drag (1/s). docs/02 §20.1."
        },
        "wind": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -40,
            "maximum": 40
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Wind (m/s²). docs/02 §20.1. [x, y]"
        },
        "dive": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Dive (m/s²). docs/02 §20.1."
        },
        "jetDisabled": {
          "type": "boolean",
          "description": "Jetpacks off. docs/02 §20.1."
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the map."
        },
        "kind": {
          "oneOf": [
            {
              "const": "gravitySurge",
              "description": "Gravity surge. Defaults: name GRAVITY SURGE, description Everything is heavier: jets climb slowly, duration 15, warning 3, gravityMul 1.8."
            },
            {
              "const": "lowGravity",
              "description": "Low gravity. Defaults: name LOW GRAVITY, description Everything floats: long jumps, slow falls, duration 15, warning 3, gravityMul 0.35."
            },
            {
              "const": "emp",
              "description": "EMP storm. Defaults: name EMP STORM, description Jetpacks offline, duration 8, warning 4, jetDisabled true."
            },
            {
              "const": "fog",
              "description": "Fog bank. Defaults: name FOG BANK, description Bullets fall short, duration 20, warning 3, bulletRangeMul 0.4."
            },
            {
              "const": "gust",
              "description": "Wind gusts. Defaults: name WIND GUSTS, description Gusts throw fliers and grenades sideways, duration 15, warning 3, wind [16, 0], gustPeriod 3, windFlip true."
            },
            {
              "const": "flip",
              "description": "Gravity pocket. Defaults: name GRAVITY POCKET, description Gravity flips inside the marked zone, duration 15, warning 4, pickOneZone true."
            },
            {
              "const": "custom",
              "description": "Custom. Defaults: name MAP EVENT, description , duration 10, warning 3."
            }
          ],
          "description": "Fills in every field the event leaves out."
        },
        "name": {
          "type": "string",
          "description": "Banner title, e.g. \"EMP STORM\"."
        },
        "description": {
          "type": "string",
          "description": "Banner line."
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600,
          "description": "Seconds."
        },
        "warning": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Seconds of \"incoming\" banner before it starts."
        },
        "gustPeriod": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Wind swells and fades every this many seconds."
        },
        "windFlip": {
          "type": "boolean",
          "description": "Some occurrences blow the other way."
        },
        "pickOneZone": {
          "type": "boolean",
          "description": "Switch on one of its event zones per occurrence, not all."
        },
        "gravityMul": {
          "type": "number",
          "minimum": -2,
          "maximum": 3,
          "description": "Gravity (×). docs/02 §20.1."
        },
        "fuelBurnMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Fuel burn (×). docs/02 §20.1."
        },
        "fuelRegenMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Fuel refill (×). docs/02 §20.1."
        },
        "bulletRangeMul": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 4,
          "description": "Bullet range (×). docs/02 §20.1."
        },
        "moveSpeedMul": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3,
          "description": "Move speed (×). docs/02 §20.1."
        },
        "knockbackMul": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Knockback (×). docs/02 §20.1."
        },
        "drag": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Drag (1/s). docs/02 §20.1."
        },
        "wind": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -40,
            "maximum": 40
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Wind (m/s²). docs/02 §20.1. [x, y]"
        },
        "dive": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Dive (m/s²). docs/02 §20.1."
        },
        "jetDisabled": {
          "type": "boolean",
          "description": "Jetpacks off. docs/02 §20.1."
        }
      }
    },
    "events": {
      "type": "object",
      "required": [
        "defs",
        "schedule"
      ],
      "additionalProperties": false,
      "properties": {
        "defs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "maxItems": 32
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "start",
                "cycle"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "random"
                },
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Seconds before the first cycle."
                },
                "cycle": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Seconds per cycle; at most one event per cycle."
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Chance a cycle has an event (default 1)."
                },
                "weights": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  },
                  "description": "By event id (default 1; 0 leaves one out)."
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "entries"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "timeline"
                },
                "start": {
                  "type": "number",
                  "minimum": 0
                },
                "loop": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "Repeat every this many seconds."
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "at",
                      "event"
                    ],
                    "properties": {
                      "at": {
                        "type": "number",
                        "description": "Seconds after start: the event starts (its warning before)."
                      },
                      "event": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
